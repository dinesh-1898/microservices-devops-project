pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/dinesh-1898/microservices-devops-project.git'
            }
        }

        stage('Build Docker Images') {
            steps {
                sh 'docker compose build'
            }
        }

        stage('Show Images') {
            steps {
                sh 'docker images'
            }
        }

    }
}
